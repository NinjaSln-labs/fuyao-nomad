{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NinjaSln-labs/fuyao-nomad/schemas/template-dod/v0",
  "type": "object",
  "required": ["flow_weight", "dod"],
  "additionalProperties": false,
  "properties": {
    "flow_weight": { "type": "string", "minLength": 1 },
    "dod": {
      "type": "object",
      "required": ["deliverables", "checklist"],
      "properties": {
        "deliverables": { "type": "array", "items": { "type": "string" } },
        "boundaries": { "type": "array", "items": { "type": "string" } },
        "checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "required"],
            "properties": {
              "id": { "type": "string" },
              "required": { "type": "boolean" },
              "description": { "type": "string" },
              "plan_refs": {
                "type": "object",
                "additionalProperties": false,
                "description": "与 plan-progress 里程碑/工作项的双向联动引用",
                "properties": {
                  "milestone_ids": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "work_item_ids": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
