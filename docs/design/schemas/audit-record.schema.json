{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NinjaSln-labs/fuyao-nomad/schemas/audit-record/v0",
  "title": "Fuyao Nomad Audit Record",
  "type": "object",
  "required": ["audit"],
  "properties": {
    "audit": {
      "type": "object",
      "required": ["type", "flow_weight", "verdict", "recorded_at"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["design", "implementation", "code_quality"]
        },
        "flow_weight": { "type": "string", "minLength": 1 },
        "verdict": {
          "type": "string",
          "enum": ["pass", "pass_with_notes", "blocked"]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "status"],
            "properties": {
              "id": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["critical", "major", "minor", "note"]
              },
              "location": { "type": "string" },
              "description": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["fixed", "recorded", "open"]
              }
            }
          }
        },
        "auditor_slot_id": { "type": "string" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
