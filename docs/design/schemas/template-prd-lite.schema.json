{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NinjaSln-labs/fuyao-nomad/schemas/template-prd-lite/v1-template",
  "title": "Fuyao Nomad PRD-lite Template",
  "description": "重端可选产物；非框架全局权威。见 delivery-model 去权威化。",
  "type": "object",
  "required": ["flow_weight", "prd"],
  "additionalProperties": false,
  "properties": {
    "flow_weight": { "type": "string", "minLength": 1 },
    "prd": {
      "type": "object",
      "required": ["title", "intent", "scope_in", "scope_out", "acceptance"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "intent": { "type": "string", "description": "一句话意图（可对齐 plan.intent）" },
        "problem_ref": {
          "type": "string",
          "description": "问题陈述文档或模板实例路径"
        },
        "users": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope_in": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "scope_out": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "可验收信号（可链 DoD checklist id）"
        },
        "identity_constraints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "从 intent 保留的身份约束（不可裁剪）；见 identity-constraints.md"
        },
        "risks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "plan_refs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "milestone_ids": { "type": "array", "items": { "type": "string" } },
            "work_item_ids": { "type": "array", "items": { "type": "string" } }
          }
        },
        "authority_note": {
          "type": "string",
          "description": "须声明：非全局最高权威；冲突时以 ADR / 领域模型 / 意图链为准"
        }
      }
    }
  }
}
