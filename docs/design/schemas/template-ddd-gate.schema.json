{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NinjaSln-labs/fuyao-nomad/schemas/template-ddd-gate/v0",
  "type": "object",
  "required": ["flow_weight", "ddd_gate"],
  "additionalProperties": false,
  "properties": {
    "flow_weight": { "type": "string", "minLength": 1 },
    "ddd_gate": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "required": { "type": "boolean" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "required"],
            "properties": {
              "id": { "type": "string" },
              "required": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
